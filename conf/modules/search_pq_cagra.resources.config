/*
 * Input-scaled host memory for SEARCH_PQ_CAGRA on CPU and GPU.
 *
 * Device memory is allocated separately by CUDA and is not represented by
 * Nextflow's memory directive.
 */

process {
    withName: '.*SEARCH_PQ_CAGRA' {
        ext.gpu_memory_gb = {
            def enabled = { value ->
                value instanceof Boolean ? value : value?.toString()?.toBoolean()
            }

            def query_windows = Math.max(0L, n_query_windows as long)
            def database_windows = Math.max(0L, (database_meta.n_windows ?: 0L) as long)
            def window_size = Math.max(1L, (database_meta.window_size ?: params.window_size) as long)
            def dimension = Math.max(1L, (database_meta.embedding_dim ?: 128L) as long)
            def pq_m = Math.max(1L, (database_meta.pq_m ?: params.pq_m) as long)
            def nbits = Math.max(1L, Math.min(8L, (database_meta.pq_nbits ?: params.pq_nbits) as long))
            def graph_degree = Math.max(1L, (database_meta.graph_degree ?: params.cagra_graph_degree) as long)
            def separate_rerank = enabled.call(params.exact_rerank) || enabled.call(params.hnswlib_rerank)
            def search_k = Math.max(1L, (separate_rerank ? params.candidate_k : params.seed_k) as long)
            def itopk = Math.max(search_k, params.cagra_itopk_size as long)
            def result_count = itopk + graph_degree
            def result_padded = Math.pow(
                2d,
                Math.ceil(Math.log(Math.max(1L, result_count) as double) / Math.log(2d))
            ) as long
            def ksub = 1L << (nbits as int)
            def index_bytes = 32L + dimension * ksub * 4L
            index_bytes += database_windows * (window_size * pq_m + graph_degree * 4L)

            def per_query_bytes = window_size * dimension * 4L
            per_query_bytes += search_k * 8L
            per_query_bytes += (1L << 16) * 4L
            per_query_bytes += result_padded * 8L

            def total_bytes = 512L * 1024L * 1024L + index_bytes
            total_bytes += query_windows * per_query_bytes

            def gib = 1024d * 1024d * 1024d
            Math.max(1L, Math.ceil(total_bytes * 1.25d / gib) as long)
        }

        memory = {
            def enabled = { value ->
                value instanceof Boolean ? value : value?.toString()?.toBoolean()
            }

            def query_windows = Math.max(0L, n_query_windows as long)
            def database_windows = Math.max(0L, (database_meta.n_windows ?: 0L) as long)
            def window_size = Math.max(1L, (database_meta.window_size ?: params.window_size) as long)
            def dimension = Math.max(1L, (database_meta.embedding_dim ?: 128L) as long)
            def pq_m = Math.max(1L, (database_meta.pq_m ?: params.pq_m) as long)
            def nbits = Math.max(1L, Math.min(8L, (database_meta.pq_nbits ?: params.pq_nbits) as long))
            def graph_degree = Math.max(1L, (database_meta.graph_degree ?: params.cagra_graph_degree) as long)
            def separate_rerank = enabled.call(params.exact_rerank) || enabled.call(params.hnswlib_rerank)
            def search_k = Math.max(1L, (separate_rerank ? params.candidate_k : params.seed_k) as long)
            def itopk = Math.max(search_k, params.cagra_itopk_size as long)

            def ksub = 1L << (nbits as int)
            def codebook_bytes = dimension * ksub * 4L
            def index_bytes = 32L + codebook_bytes
            index_bytes += database_windows * (window_size * pq_m + graph_degree * 4L)
            def query_bytes = query_windows * window_size * dimension * 4L
            def query_mapping_bytes = query_windows * 128L
            def target_mapping_bytes = database_windows * 192L
            def result_bytes = query_windows * search_k * 200L

            def cpu_workspace_bytes = 0L
            if (params.search_device == 'cpu' || params.cagra_to_hnsw) {
                def active_workers = Math.min(
                    Math.max(1L, task.cpus as long),
                    Math.max(1L, query_windows)
                )
                def code_dimension = window_size * pq_m
                def per_worker = code_dimension * ksub * 4L
                per_worker += (1L << 16) * 4L
                per_worker += (itopk + graph_degree) * 20L
                cpu_workspace_bytes = active_workers * per_worker
            }

            // Query loading and row normalization overlap at three float32
            // copies. The target table and emitted hit tuples are Python objects.
            def total_bytes = 512L * 1024L * 1024L
            total_bytes += index_bytes + target_mapping_bytes
            total_bytes += 3L * query_bytes + query_mapping_bytes + result_bytes
            total_bytes += cpu_workspace_bytes

            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
