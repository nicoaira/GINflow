/* Input-scaled host memory for CLUSTER_SEEDS. */

process {
    withName: '.*CLUSTER_SEEDS' {
        memory = {
            def rows = Math.max(0L, n_seed_rows as long)
            // DictReader rows, pair-group lists, NumPy work arrays, and the
            // retained member dictionaries together cost about 1.5 KiB/seed.
            def total_bytes = 256L * 1024L * 1024L + rows * 1536L
            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(1L, requested_gb) * 1.GB * task.attempt
        }
    }
}
