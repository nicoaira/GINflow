/*
 * Input-scaled memory for ALIGN_CLUSTERS.
 *
 * The closure runs during task resource evaluation, after the cluster,
 * metadata, and database inputs have been staged.
 */

process {
    withName: '.*ALIGN_CLUSTERS' {
        memory = {
            def input_paths = { input_value ->
                if (input_value instanceof Collection) {
                    return input_value
                }
                [input_value]
            }

            def as_path = { input_value ->
                if (input_value instanceof nextflow.processor.TaskPath) {
                    return input_value.toRealPath()
                }
                if (input_value instanceof java.nio.file.Path) {
                    return input_value
                }
                java.nio.file.Paths.get(input_value.toString())
            }

            def path_text = { input_value ->
                def path = as_path.call(input_value)
                def stream = path.getFileSystem().provider().newInputStream(path)
                def text = stream.getText('UTF-8')
                stream.close()
                text
            }

            def database_root = { database ->
                def database_value = database
                if (database instanceof Collection) {
                    database_value = database[0]
                }
                as_path.call(database_value)
            }

            def metadata_lengths = { paths ->
                def lengths = [:]
                input_paths
                    .call(paths)
                    .each { path ->
                        def metadata_text = path_text.call(path)
                        if (metadata_text?.trim()) {
                            def payload = new groovy.json.JsonSlurperClassic().parseText(metadata_text)
                            def identifiers = payload.identifiers ?: []
                            def sequences = payload.sequences ?: []
                            identifiers.eachWithIndex { identifier, index ->
                                if (index < sequences.size()) {
                                    lengths[identifier.toString()] = sequences[index].toString().size() as long
                                }
                            }
                        }
                    }
                lengths
            }

            def record_lengths = { database ->
                def lengths = [:]
                def records_path = database_root.call(database).resolve('records.tsv')
                if (records_path.exists()) {
                    path_text
                        .call(records_path)
                        .eachLine { line, line_number ->
                            if (line_number > 1 && line) {
                                def columns = line.split('\t', 3)
                                if (columns.size() > 1) {
                                    lengths[columns[0]] = columns[1].size() as long
                                }
                            }
                        }
                }
                lengths
            }

            def embedding_dimension = { database ->
                def metadata_path = database_root.call(database).resolve('meta.json')
                if (!metadata_path.exists()) {
                    return 128L
                }
                def payload = new groovy.json.JsonSlurperClassic().parseText(path_text.call(metadata_path))
                Math.max(1L, (payload.embedding_dim ?: 128L) as long)
            }

            def work_stats = { clusters, query_lengths, target_lengths, pad, max_cells ->
                def lines = path_text.call(clusters).readLines()
                def stats = [
                    jobs: 0L,
                    score_cells: 0d,
                    max_job_cells: 0d,
                    max_query: 0L,
                    max_target: 0L,
                    query_residues: 0L,
                    target_residues: 0L,
                ]
                if (lines.size() < 1) {
                    return stats
                }

                def header = lines[0].split('\t', -1)
                def columns = [:]
                header.eachWithIndex { name, index -> columns[name] = index }
                def required = ['query_id', 'target_id', 'query_start', 'query_end', 'target_start', 'target_end']
                if (required.any { column_name -> !columns.containsKey(column_name) }) {
                    return stats
                }

                def query_ids = [] as Set
                def target_ids = [] as Set
                def query_fallback_lengths = [:]
                def target_fallback_lengths = [:]
                lines
                    .drop(1)
                    .each { line ->
                        if (line) {
                            def fields = line.split('\t', -1)
                            def query_id = fields[columns.query_id]
                            def target_id = fields[columns.target_id]
                            def query_start = fields[columns.query_start] as long
                            def query_end = fields[columns.query_end] as long
                            def target_start = fields[columns.target_start] as long
                            def target_end = fields[columns.target_end] as long
                            query_ids.add(query_id)
                            target_ids.add(target_id)

                            def query_fallback = Math.max(1L, query_end + pad)
                            def target_fallback = Math.max(1L, target_end + pad)
                            query_fallback_lengths[query_id] = Math.max(query_fallback_lengths[query_id] ?: 0L, query_fallback)
                            target_fallback_lengths[target_id] = Math.max(target_fallback_lengths[target_id] ?: 0L, target_fallback)

                            def query_length = Math.max(1L, (query_lengths[query_id] ?: query_fallback_lengths[query_id]) as long)
                            def target_length = Math.max(1L, (target_lengths[target_id] ?: target_fallback_lengths[target_id]) as long)
                            def query_crop_start = Math.max(0L, query_start - pad)
                            def query_crop_end = Math.min(query_length, query_end + pad)
                            def target_crop_start = Math.max(0L, target_start - pad)
                            def target_crop_end = Math.min(target_length, target_end + pad)
                            def query_crop = Math.max(0L, query_crop_end - query_crop_start)
                            def target_crop = Math.max(0L, target_crop_end - target_crop_start)
                            def cells = (query_crop as double) * (target_crop as double)
                            if (query_crop > 0L && target_crop > 0L && cells <= max_cells as double) {
                                stats.jobs += 1L
                                stats.score_cells += cells
                                stats.max_job_cells = Math.max(stats.max_job_cells, cells)
                                stats.max_query = Math.max(stats.max_query, query_crop)
                                stats.max_target = Math.max(stats.max_target, target_crop)
                            }
                        }
                    }

                query_ids.each { identifier ->
                    stats.query_residues += (query_lengths[identifier] ?: query_fallback_lengths[identifier] ?: 0L) as long
                }
                target_ids.each { identifier ->
                    stats.target_residues += (target_lengths[identifier] ?: target_fallback_lengths[identifier] ?: 0L) as long
                }
                stats
            }

            def query_lengths = metadata_lengths.call(query_metadata)
            def target_lengths = record_lengths.call(database)
            def work = work_stats.call(clusters, query_lengths, target_lengths, params.align_pad as long, params.align_max_cells as long)
            def dimension = embedding_dimension.call(database)
            def worker_count = Math.max(1L, task.cpus as long)
            def active_workers = Math.min(worker_count, Math.max(1L, work.jobs as long))

            def gib = 1024d * 1024d * 1024d
            def normalized_bytes = (work.query_residues + work.target_residues) * (dimension as double) * 8d
            def score_bytes = work.score_cells * 8d + work.max_job_cells * 16d
            def batch_bytes = work.jobs > 0L ? Math.max(64d * 1024d * 1024d, work.max_job_cells * 8d) : 0d
            def buffer_bytes = work.jobs * (work.max_query + work.max_target + 2d) * 16d
            def traceback_bytes = active_workers * (work.max_job_cells * 3d + (work.max_query + work.max_target) * 64d + 1024d * 1024d)
            def metadata_bytes = 64d * 1024d * 1024d + (work.query_residues + work.target_residues) * 8d

            // Input arrays, retained score matrices, batched DP buffers, and traceback.
            def total_bytes = 512d * 1024d * 1024d
            total_bytes += normalized_bytes * 2d + score_bytes + batch_bytes + buffer_bytes
            total_bytes += traceback_bytes + metadata_bytes
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
