/*
 * Input-scaled host RAM and GPU VRAM for BUILD_CUVS_INDEX.
 * Nextflow's memory directive controls host RAM only.
 */

process {
    withName: '.*BUILD_CUVS_INDEX' {
        accelerator = 1

        ext.gpu_memory_gb = {
            def count = Math.max(0L, n_windows as long)
            def dimension = Math.max(1L, (params.window_size as long) * 128L)
            def kind = params.index.toString().toLowerCase()
            def graph_degree = Math.max(
                1L,
                Math.min(params.cagra_graph_degree as long, Math.max(1L, count - 1L))
            )

            def working_bytes
            if (kind == 'ivf') {
                def requested_lists = params.cuvs_n_lists == null ? 0L : params.cuvs_n_lists as long
                def n_lists = requested_lists > 0L
                    ? Math.min(count, requested_lists)
                    : Math.max(1L, Math.min(count, (4d * Math.sqrt(Math.max(1L, count) as double)) as long))
                // Input, populated lists, and the default 50% k-means train set.
                working_bytes = 3L * count * dimension * 4L
                working_bytes += count * 16L + n_lists * dimension * 4L
            }
            else {
                // NN-descent converts the input to fp16 and keeps two 32-wide
                // graph/distance buffers. The final index briefly overlaps a
                // second float32 dataset copy with the optimized graph.
                def nn_descent_peak = count * (dimension * 6L + 2L * 32L * 4L + 20L)
                def final_index_peak = count * (dimension * 8L + graph_degree * 4L)
                working_bytes = Math.max(nn_descent_peak, final_index_peak)
            }

            def total_bytes = 512L * 1024L * 1024L + working_bytes
            def gib = 1024d * 1024d * 1024d
            Math.max(1L, Math.ceil(total_bytes * 1.25d / gib) as long)
        }

        memory = {
            def count = Math.max(0L, n_windows as long)
            def node_count = Math.max(0L, n_nodes as long)
            def dimension = Math.max(1L, (params.window_size as long) * 128L)
            def kind = params.index.toString().toLowerCase()
            def intermediate_degree = Math.max(
                1L,
                Math.min(params.cagra_intermediate_graph_degree as long, Math.max(1L, count - 1L))
            )
            def graph_degree = Math.max(
                1L,
                Math.min(params.cagra_graph_degree as long, Math.max(1L, count - 1L))
            )
            def mapping_bytes = count * 192L
            def window_bytes = count * dimension * 4L

            def build_peak = 2L * window_bytes + mapping_bytes
            if (kind != 'ivf') {
                build_peak += count * (intermediate_degree + graph_degree) * 4L
                if (params.cagra_build_algo.toString().toLowerCase() == 'nn_descent') {
                    build_peak += count * (intermediate_degree * 4L + 8L * 32L * 4L)
                }
            }

            def embedding_bytes = node_count * 128L * 2L
            def pack_peak = mapping_bytes + 2L * embedding_bytes
            if (kind != 'ivf' && params._parse_boolean.call(params.cagra_to_hnsw, false)) {
                pack_peak += count * (dimension * 4L + graph_degree * 4L)
            }

            def total_bytes = 512L * 1024L * 1024L + Math.max(build_peak, pack_peak)
            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
