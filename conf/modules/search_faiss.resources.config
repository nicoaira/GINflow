/* Resource selection for SEARCH_FAISS. */

process {
    withName: '.*SEARCH_FAISS' {
        accelerator = {
            def device = params.faiss_device == null
                ? 'cpu'
                : params.faiss_device.toString().trim().toLowerCase()
            def legacy_gpu = params.faiss_gpu
            (device in ['gpu', 'cuda'] || legacy_gpu) ? 1 : null
        }
    }
}
