/* Input-scaled host memory for GENERATE_QUANTIZED_WINDOWS. */

process {
    withName: '.*GENERATE_QUANTIZED_WINDOWS' {
        memory = {
            def stats = quantized_window_stats ?: [:]
            def max_shard_nodes = Math.max(0L, (stats.max_shard_nodes ?: 0L) as long)
            def max_record_nodes = Math.max(0L, (stats.max_record_nodes ?: 0L) as long)
            def max_shard_windows = Math.max(0L, (stats.max_shard_windows ?: 0L) as long)
            def max_record_windows = Math.max(0L, (stats.max_record_windows ?: 0L) as long)
            def window_size = Math.max(1L, params.window_size as long)
            def dimension = 128L
            def mode = params.quantize.toString().toLowerCase()

            def working_bytes
            if (mode == 'sq') {
                def shard_output = max_shard_windows * window_size * dimension * 4L
                def record_decode = max_record_nodes * dimension * 13L
                def record_windows = max_record_windows * window_size * dimension * 4L
                working_bytes = 2L * shard_output + record_decode + record_windows
            }
            else {
                def pq_m = Math.max(1L, params.pq_m as long)
                def nbits = Math.max(1L, Math.min(8L, params.pq_nbits as long))
                def packed_node_bytes = ((pq_m * nbits + 7L) / 8L) as long
                def shard_output = max_shard_windows * window_size * packed_node_bytes
                def record_codes = max_record_nodes * pq_m
                def bit_packing = max_record_windows * window_size * pq_m * (1L + 2L * nbits)
                def packed_record = max_record_windows * window_size * packed_node_bytes
                working_bytes = shard_output + record_codes + bit_packing + packed_record
            }

            // The largest code shard is resident while its compressed NPZ is written.
            working_bytes += max_shard_nodes * (mode == 'sq' ? dimension : Math.max(1L, params.pq_m as long))
            def total_bytes = 256L * 1024L * 1024L + working_bytes
            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(1L, requested_gb) * 1.GB * task.attempt
        }
    }
}
