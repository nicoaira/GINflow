/* Input-scaled host RAM and CUDA VRAM for RERANK_CANDIDATES. */

process {
    withName: '.*RERANK_CANDIDATES' {
        accelerator = {
            def device = params.exact_rerank_device == null
                ? 'cpu'
                : params.exact_rerank_device.toString().trim().toLowerCase()
            device in ['gpu', 'cuda'] ? 1 : null
        }

        ext.gpu_memory_gb = {
            if (!task.accelerator) {
                return 0L
            }

            def stats = query_stats ?: [:]
            def query_windows = Math.max(0L, (stats.n_windows ?: 0L) as long)
            def dimension = Math.max(1L, (database_meta.window_dim ?: (params.window_size as long) * 128L) as long)
            def batch_rows = Math.min(query_windows, Math.max(1L, params.exact_rerank_batch_size as long))
            def candidate_count = Math.max(1L, params.candidate_k as long)
            def candidate_block = Math.min(
                candidate_count,
                Math.max(1L, params.exact_rerank_candidate_batch_size as long)
            )
            def output_k = Math.min(candidate_count, Math.max(1L, params.seed_k as long))

            def candidate_bytes = batch_rows * candidate_block * dimension * 4L
            def query_bytes = batch_rows * dimension * 4L
            def result_bytes = batch_rows * (candidate_block + 4L * output_k) * 8L
            def total_bytes = 1L * 1024L * 1024L * 1024L
            total_bytes += candidate_bytes + query_bytes + result_bytes
            def gib = 1024d * 1024d * 1024d
            Math.max(1L, Math.ceil(total_bytes * 1.25d / gib) as long)
        }

        memory = {
            def stats = query_stats ?: [:]
            def query_windows = Math.max(0L, (stats.n_windows ?: 0L) as long)
            def database_windows = Math.max(0L, (database_meta.n_windows ?: 0L) as long)
            def embedding_dimension = Math.max(1L, (database_meta.embedding_dim ?: 128L) as long)
            def dimension = Math.max(1L, (database_meta.window_dim ?: (params.window_size as long) * embedding_dimension) as long)
            def record_nodes = Math.max(0L, (database_meta.n_nodes ?: 0L) as long)
            def candidate_count = Math.max(1L, params.candidate_k as long)
            def candidate_block = Math.min(
                candidate_count,
                Math.max(1L, params.exact_rerank_candidate_batch_size as long)
            )
            def batch_rows = Math.min(query_windows, Math.max(1L, params.exact_rerank_batch_size as long))
            def configured_workers = params.exact_rerank_workers as long
            def workers = task.accelerator
                ? 1L
                : (configured_workers > 0L ? configured_workers : Math.max(1L, task.cpus as long))
            def batches = batch_rows > 0L ? Math.ceil(query_windows / batch_rows as double) as long : 0L
            def active_workers = Math.min(workers, Math.max(1L, batches))

            def target_metadata = database_windows * 224L
            def residue_embeddings = record_nodes * embedding_dimension * 2L
            def query_vectors = 2L * query_windows * dimension * 4L + query_windows * 224L
            def candidate_rows = query_windows * candidate_count
            def candidate_metadata = candidate_rows * 192L + candidate_rows * 8L
            def worker_buffers = active_workers * 2L * batch_rows * candidate_block * dimension * 4L
            def result_bytes = query_windows * Math.max(1L, params.seed_k as long) * 16L

            def total_bytes = 512L * 1024L * 1024L
            total_bytes += target_metadata + residue_embeddings + query_vectors
            total_bytes += candidate_metadata + worker_buffers + result_bytes
            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
