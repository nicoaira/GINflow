/*
 * Shared runtime options for processes that can request an NVIDIA GPU.
 * Per-process accelerator directives remain in the corresponding resource
 * configuration so CPU/GPU selection stays local to each module.
 */

process {
    withName: '.*EMBED_RNA_GRAPHS|.*RERANK_CANDIDATES|.*SEARCH_PQ_CAGRA|.*SEARCH_CUVS|.*BUILD_FAISS_INDEX|.*SEARCH_FAISS|.*BUILD_CUVS_INDEX|.*BUILD_PQ_CAGRA_INDEX' {
        containerOptions = {
            if (!task.accelerator) {
                return null
            }
            if (params.gpu_container_options) {
                return params.gpu_container_options
            }
            if (workflow.containerEngine in ['singularity', 'apptainer']) {
                return '--nv'
            }
            if (workflow.containerEngine == 'docker') {
                return '--gpus all'
            }
            return null
        }
    }
}
