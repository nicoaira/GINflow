/*
 * Shared runtime options for processes that can request an NVIDIA GPU.
 * Per-process accelerator directives remain in the corresponding resource
 * configuration so CPU/GPU selection stays local to each module.
 */

// Config files cannot share top-level methods, so keep one parser closure in
// the common config and expose it only as a private internal parameter.
params._parse_boolean = { value, default_value = false ->
    if (value == null) {
        return default_value
    }
    if (value instanceof Boolean) {
        return value
    }
    def text = value.toString().trim().toLowerCase()
    if (text in ['true', '1', 'yes', 'y', 'on']) {
        return true
    }
    if (text in ['false', '0', 'no', 'n', 'off', '']) {
        return false
    }
    throw new IllegalArgumentException("must be true or false, got '${value}'")
}

process {
    withName: '.*EMBED_RNA_GRAPHS|.*RERANK_CANDIDATES|.*SEARCH_PQ_CAGRA|.*SEARCH_CUVS|.*BUILD_FAISS_INDEX|.*SEARCH_FAISS|.*BUILD_CUVS_INDEX|.*BUILD_PQ_CAGRA_INDEX' {
        containerOptions = {
            if (!task.accelerator) {
                return null
            }
            if (params.gpu_container_options) {
                return params.gpu_container_options
            }
            if (workflow.containerEngine in ['singularity', 'apptainer']) {
                return '--nv'
            }
            if (workflow.containerEngine == 'docker') {
                return '--gpus all'
            }
            return null
        }
    }
}
