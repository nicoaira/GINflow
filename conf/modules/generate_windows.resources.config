/* Input-scaled host memory for GENERATE_WINDOWS. */

process {
    withName: '.*GENERATE_WINDOWS' {
        memory = {
            def stats = [n_nodes: 0L, max_record_nodes: 0L, n_windows: 0L, max_record_windows: 0L]
            def dimension = 128L
            def window_size = Math.max(1L, params.window_size as long)
            def stride = Math.max(1L, params.window_stride as long)
            try {
                def manifest_file = manifest.toFile()
                def payload = new groovy.json.JsonSlurperClassic().parseText(manifest_file.text)
                (payload.records ?: []).each { record ->
                    def shape = record.shape instanceof Collection ? record.shape : []
                    def length = Math.max(
                        0L,
                        (shape ? shape[0] : (record.core_length ?: record.node_count ?: record.length ?: 0L)) as long
                    )
                    if (shape && shape.size() > 1) {
                        dimension = Math.max(1L, (shape[1] ?: dimension) as long)
                    }
                    def windows = length < window_size
                        ? 0L
                        : ((length - window_size) / stride) as long + 1L
                    stats.n_nodes += length
                    stats.max_record_nodes = Math.max(stats.max_record_nodes as long, length)
                    stats.n_windows += windows
                    stats.max_record_windows = Math.max(stats.max_record_windows as long, windows)
                }
            }
            catch (Exception _ignored) {
                // Manifest not readable (e.g. stub runs); estimate from the
                // graph sidecar stats attached to the task meta, else the floor.
                def resource_stats = meta.resource_stats ?: [:]
                def total_nodes = Math.max(0L, (resource_stats.node_count ?: 0L) as long)
                if (total_nodes > 0L) {
                    stats.n_nodes = total_nodes
                    stats.n_windows = total_nodes
                    // Without per-record lengths, assume the whole shard can
                    // be one record so the transient peak is not understated.
                    stats.max_record_nodes = total_nodes
                    stats.max_record_windows = total_nodes
                }
            }

            // slice_windows.py keeps every record's normalized windows resident
            // while the current record's embedding and flattened window copies
            // are transient, then writes the compressed NPZ.
            def window_bytes = stats.n_windows * window_size * dimension * 4L
            def record_transient = stats.max_record_windows * window_size * dimension * 4L * 2L
            def embedding_bytes = stats.max_record_nodes * dimension * 4L
            def total_bytes = 256L * 1024L * 1024L + window_bytes + record_transient + embedding_bytes
            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
