/* Input-scaled host memory for FIT_NODE_QUANTIZER. */

process {
    withName: '.*FIT_NODE_QUANTIZER' {
        memory = {
            def count = Math.max(0L, n_nodes as long)
            def dimension = 128L
            def mode = params.quantize.toString().toLowerCase()
            def sample_count = Math.min(count, Math.max(1L, (params.pq_sample_size ?: 250000L) as long))
            def pq_m = Math.max(1L, params.pq_m as long)
            def nbits = Math.max(1L, Math.min(8L, params.pq_nbits as long))
            def ksub = 1L << (nbits as int)
            def dsub = Math.max(1L, (dimension / pq_m) as long)

            def matrix_bytes = count * dimension * 4L
            def sample_bytes = sample_count * dimension * 4L
            def codes_bytes = count * pq_m
            def assignment_bytes = count * 8L
            def kmeans_bytes = 3L * sample_count * ksub * 4L
            kmeans_bytes += sample_count * dsub * 4L + sample_count * 8L

            def working_bytes
            if (mode == 'sq') {
                // Normalization, affine scaling, rounding, and clipping can
                // overlap at five float32 matrices plus the uint8 codes.
                working_bytes = 5L * matrix_bytes + count * dimension
            }
            else if (mode == 'opq') {
                def training_peak = 2L * matrix_bytes + 3L * sample_bytes + kmeans_bytes
                def final_encode_peak = 3L * matrix_bytes + codes_bytes + assignment_bytes
                working_bytes = Math.max(training_peak, final_encode_peak)
            }
            else {
                working_bytes = 2L * matrix_bytes + sample_bytes
                working_bytes += codes_bytes + assignment_bytes + kmeans_bytes
            }

            def total_bytes = 512L * 1024L * 1024L + working_bytes
            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
