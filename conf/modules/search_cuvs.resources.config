/*
 * Input-scaled host RAM and GPU VRAM for SEARCH_CUVS.
 * Nextflow's memory directive controls host RAM only.
 */

process {
    withName: '.*SEARCH_CUVS' {
        accelerator = {
            def device = params.search_device == null
                ? 'gpu'
                : params.search_device.toString().trim().toLowerCase()
            def converted = params.cagra_to_hnsw
            (device == 'cpu' || converted) ? null : 1
        }

        ext.gpu_memory_gb = {
            if (!task.accelerator) {
                return 0L
            }

            def stats = query_stats ?: [:]
            def database_windows = Math.max(0L, (database_meta.n_windows ?: 0L) as long)
            def query_peak = Math.max(0L, (stats.max_record_windows ?: 0L) as long)
            def dimension = Math.max(1L, (database_meta.window_dim ?: (params.window_size as long) * 128L) as long)
            def index_type = (database_meta.index_type ?: params.index).toString().toUpperCase()
            def graph_degree = Math.max(1L, (database_meta.graph_degree ?: params.cagra_graph_degree) as long)
            def n_lists = Math.max(1L, (database_meta.n_lists ?: 1L) as long)
            def separate_rerank = params.exact_rerank || params.hnswlib_rerank
            def search_k = Math.max(1L, (separate_rerank ? params.candidate_k : params.seed_k) as long)
            def itopk = Math.max(search_k, (database_meta.itopk_size ?: params.cagra_itopk_size) as long)

            def index_bytes
            if (index_type == 'IVF') {
                index_bytes = Math.ceil(database_windows * dimension * 4d * 1.25d) as long
                index_bytes += database_windows * 8L + n_lists * dimension * 4L
            }
            else {
                index_bytes = database_windows * (dimension * 4L + graph_degree * 4L)
            }
            def query_bytes = query_peak * dimension * 4L
            def result_bytes = query_peak * search_k * 12L
            def traversal_bytes = index_type == 'IVF'
                ? query_peak * Math.max(search_k, n_lists) * 8L
                : query_peak * (itopk + graph_degree) * 64L

            def total_bytes = 512L * 1024L * 1024L
            total_bytes += index_bytes + query_bytes + result_bytes + traversal_bytes
            def gib = 1024d * 1024d * 1024d
            Math.max(1L, Math.ceil(total_bytes * 1.25d / gib) as long)
        }

        memory = {
            def stats = query_stats ?: [:]
            def database_windows = Math.max(0L, (database_meta.n_windows ?: 0L) as long)
            def query_windows = Math.max(0L, (stats.n_windows ?: 0L) as long)
            def query_peak = Math.max(0L, (stats.max_record_windows ?: 0L) as long)
            def dimension = Math.max(1L, (database_meta.window_dim ?: (params.window_size as long) * 128L) as long)
            def index_type = (database_meta.index_type ?: params.index).toString().toUpperCase()
            def graph_degree = Math.max(1L, (database_meta.graph_degree ?: params.cagra_graph_degree) as long)
            def n_lists = Math.max(1L, (database_meta.n_lists ?: 1L) as long)
            def separate_rerank = params.exact_rerank || params.hnswlib_rerank
            def search_k = Math.max(1L, (separate_rerank ? params.candidate_k : params.seed_k) as long)

            def index_bytes
            if (index_type == 'IVF') {
                index_bytes = Math.ceil(database_windows * dimension * 4d * 1.25d) as long
                index_bytes += database_windows * 8L + n_lists * dimension * 4L
            }
            else {
                index_bytes = database_windows * (dimension * 4L + graph_degree * 4L)
            }
            def target_mapping_bytes = database_windows * 192L
            def query_bytes = 2L * query_peak * dimension * 4L
            def hit_bytes = query_windows * search_k * 192L

            // Loading may transiently retain one host copy of the serialized
            // index even when the searchable copy ultimately resides on GPU.
            def total_bytes = 512L * 1024L * 1024L
            total_bytes += index_bytes + target_mapping_bytes + query_bytes + hit_bytes
            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
