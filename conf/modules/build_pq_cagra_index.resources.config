/*
 * Input-scaled host memory for BUILD_PQ_CAGRA_INDEX.
 *
 * Device memory is allocated separately by CUDA and is not represented by
 * Nextflow's memory directive.
 */

process {
    withName: '.*BUILD_PQ_CAGRA_INDEX' {
        accelerator = 1

        ext.gpu_memory_gb = {
            def count = Math.max(0L, n_windows as long)
            def window_size = Math.max(1L, params.window_size as long)
            def pq_m = Math.max(1L, params.pq_m as long)
            def nbits = Math.max(1L, Math.min(8L, params.pq_nbits as long))
            def intermediate_degree = Math.max(
                1L,
                Math.min(params.cagra_intermediate_graph_degree as long, Math.max(1L, count - 1L))
            )
            def graph_degree = Math.max(
                1L,
                Math.min(params.cagra_graph_degree as long, Math.max(1L, count - 1L))
            )
            def ksub = 1L << (nbits as int)

            def total_bytes = 512L * 1024L * 1024L
            total_bytes += count * (
                window_size * pq_m + 3L * intermediate_degree * 4L + graph_degree * 4L + 4L
            )
            total_bytes += pq_m * ksub * ksub * 4L

            def gib = 1024d * 1024d * 1024d
            Math.max(1L, Math.ceil(total_bytes * 1.25d / gib) as long)
        }

        memory = {
            def count = Math.max(0L, n_windows as long)
            def node_count = Math.max(0L, n_nodes as long)
            def window_size = Math.max(1L, params.window_size as long)
            def pq_m = Math.max(1L, params.pq_m as long)
            def graph_degree = Math.max(
                1L,
                Math.min(params.cagra_graph_degree as long, Math.max(1L, count - 1L))
            )

            def code_bytes = count * window_size * pq_m
            def graph_bytes = count * graph_degree * 4L
            def mapping_bytes = count * 128L
            def embedding_bytes = node_count * 128L * 2L

            // Python and C++ retain separate code arrays. Packing residue
            // embeddings also briefly retains the per-record and stacked copies.
            def total_bytes = 512L * 1024L * 1024L
            total_bytes += 2L * code_bytes + graph_bytes + mapping_bytes
            total_bytes += 2L * embedding_bytes

            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
