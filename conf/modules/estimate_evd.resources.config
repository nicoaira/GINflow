/*
 * Input-scaled memory for ESTIMATE_EVD.
 *
 * The closure runs during task resource evaluation, after the database input
 * has been staged, so the estimate uses the actual database payload.
 */

process {
    withName: '.*ESTIMATE_EVD' {
        memory = {
            def database_stats = { database ->
                def root = database instanceof java.nio.file.Path
                    ? database
                    : java.nio.file.Paths.get(database.toString())
                def metadata = [:]
                def metadata_path = root.resolve('meta.json')
                if (metadata_path.exists()) {
                    def parsed = new groovy.json.JsonSlurperClassic().parseText(metadata_path.text)
                    if (parsed instanceof Map) {
                        metadata = parsed
                    }
                }

                def dimension = Math.max(1L, (metadata.embedding_dim ?: 128L) as long)
                def residue_count = 0L
                def max_length = 0L
                def records_path = root.resolve('records.tsv')
                if (records_path.exists()) {
                    records_path.text.eachLine { line, line_number ->
                        if (line_number > 1 && line) {
                            def columns = line.split('\t', 3)
                            if (columns.size() > 1) {
                                def length = columns[1].size() as long
                                residue_count += length
                                max_length = Math.max(max_length, length)
                            }
                        }
                    }
                }

                def embedding_bytes = 0L
                def vectors_path = root.resolve('embeddings.vectors.npy')
                def archive_path = root.resolve('embeddings.npz')
                if (vectors_path.exists()) {
                    embedding_bytes = vectors_path.size()
                }
                else if (archive_path.exists()) {
                    def uncompressed_bytes = residue_count * dimension * 8L
                    embedding_bytes = Math.max(archive_path.size(), uncompressed_bytes)
                }

                [
                    dimension: dimension,
                    embedding_bytes: embedding_bytes,
                    max_length: max_length,
                ]
            }

            def stats = database_stats.call(database)
            def crop_length = Math.max(2L, params.evd_max_length as long)
            if (stats.max_length > 0L) {
                crop_length = Math.min(crop_length, stats.max_length as long)
            }

            def length_squared = (crop_length as double) * (crop_length as double)
            def cells = Math.min(params.align_max_cells as double, length_squared)
            def worker_count = Math.max(1L, task.cpus as long)
            def alignment_count = Math.max(1L, params.align_max_alignments as long)

            // Two float64 score matrices, traceback masks, normalization, and SW buffers.
            def score_bytes = cells * 19d
            def embedding_bytes = 8d * crop_length * (stats.dimension as double) * 8d
            def alignment_bytes = alignment_count * (crop_length * 32d + 4096d)
            def per_worker_bytes = 64d * 1024d * 1024d + score_bytes + embedding_bytes + alignment_bytes

            def total_bytes = 1d * 1024d * 1024d * 1024d
            total_bytes += stats.embedding_bytes as double
            total_bytes += worker_count * per_worker_bytes
            def requested_gb = Math.ceil(total_bytes * 1.25d / (1024d * 1024d * 1024d)) as long
            Math.max(2L, requested_gb) * 1.GB * task.attempt
        }
    }
}
