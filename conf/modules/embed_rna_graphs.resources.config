/*
 * Input-scaled host RAM and GPU VRAM for EMBED_RNA_GRAPHS.
 * Graph counts are attached to the task meta map by PREPARE_WINDOWS.
 */

process {
    withName: '.*EMBED_RNA_GRAPHS' {
        ext.gpu_memory_gb = {
            if (!task.accelerator) {
                return 0L
            }

            def stats = meta.resource_stats ?: [:]
            def total_nodes = Math.max(0L, (stats.node_count ?: 0L) as long)
            def total_edges = Math.max(0L, (stats.edge_count ?: 0L) as long)
            def batch_nodes = Math.min(total_nodes, Math.max(1L, params.max_batch_nodes as long))
            def batch_edges = Math.min(total_edges, Math.max(1L, params.max_batch_edges as long))
            def scalar_bytes = params.ginfinity_full_precision ? 4L : 2L
            def hidden = 128L

            def node_bytes = batch_nodes * (7L + 6L * hidden) * scalar_bytes
            def edge_bytes = batch_edges * ((10L + 3L * hidden) * scalar_bytes + 24L)
            def output_bytes = batch_nodes * hidden * 4L
            def total_bytes = 1L * 1024L * 1024L * 1024L
            total_bytes += node_bytes + edge_bytes + output_bytes
            def gib = 1024d * 1024d * 1024d
            Math.max(1L, Math.ceil(total_bytes * 1.25d / gib) as long)
        }

        memory = {
            def stats = meta.resource_stats ?: [:]
            def total_nodes = Math.max(0L, (stats.node_count ?: 0L) as long)
            def total_edges = Math.max(0L, (stats.edge_count ?: 0L) as long)
            def graph_bytes = Math.max(0L, (stats.graph_bytes ?: 0L) as long)
            def batch_nodes = Math.min(total_nodes, Math.max(1L, params.max_batch_nodes as long))
            def batch_edges = Math.min(total_edges, Math.max(1L, params.max_batch_edges as long))
            def scalar_bytes = params.ginfinity_full_precision ? 4L : 2L
            def hidden = 128L

            def output_bytes = total_nodes * hidden * 2L
            def normalization_bytes = batch_nodes * hidden * 20L
            def inference_bytes = 0L
            if (!task.accelerator) {
                inference_bytes += batch_nodes * (7L + 6L * hidden) * scalar_bytes
                inference_bytes += batch_edges * ((10L + 3L * hidden) * scalar_bytes + 24L)
            }

            def total_bytes = 512L * 1024L * 1024L
            total_bytes += 2L * graph_bytes + output_bytes + normalization_bytes + inference_bytes
            def gib = 1024d * 1024d * 1024d
            def requested_gb = Math.ceil(total_bytes * 1.25d / gib) as long
            Math.max(1L, requested_gb) * 1.GB * task.attempt
        }
    }
}
