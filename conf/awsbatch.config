/*
 * AWS Batch configuration for the ginflow queues in us-east-1.
 *
 * This file is included inside the local awsbatch profile after
 * nf-core/configs is loaded, so these queue and staging settings override
 * the generic nf-core awsbatch profile.
 */

params {
    awscli       = ''
    awsregion    = 'us-east-1'
    awsqueue     = 'ginflow-cpu-queue-virginia'

    // These are queue names, not compute-environment names.
    aws_cpu_queue            = 'ginflow-cpu-queue-virginia'
    aws_cpu_ondemand_queue   = 'ginflow-cpu-ondemand-queue-virginia'
    // Legacy aliases now point to the homogeneous T4 queues.
    aws_gpu_queue            = 'ginflow-gpu-t4-16gb-spot-queue'
    aws_gpu_ondemand_queue   = 'ginflow-gpu-t4-16gb-ondemand-queue'

    // GPU queues are separated by device-memory tier. The 24 GB tier is the
    // supported L4 g6 family; AWS Batch rejected the proposed g7 family.
    aws_gpu_queue_16gb          = 'ginflow-gpu-t4-16gb-spot-queue'
    aws_gpu_queue_24gb          = 'ginflow-gpu-g6-24gb-spot-queue'
    aws_gpu_queue_48gb          = 'ginflow-gpu-g6e-48gb-spot-queue'
    aws_gpu_queue_96gb          = 'ginflow-gpu-g7e-96gb-spot-queue'
    aws_gpu_ondemand_queue_16gb = 'ginflow-gpu-t4-16gb-ondemand-queue'
    aws_gpu_ondemand_queue_24gb = 'ginflow-gpu-g6-24gb-ondemand-queue'
    aws_gpu_ondemand_queue_48gb = 'ginflow-gpu-g6e-48gb-ondemand-queue'
    aws_gpu_ondemand_queue_96gb = 'ginflow-gpu-g7e-96gb-ondemand-queue'
}

aws {
    region = params.awsregion
    batch {
        // Empty means no host-side AWS CLI path is mounted.
        cliPath = params.awscli
        maxSpotAttempts = 5
        volumes = '/tmp'
    }
}

process {
    executor = 'awsbatch'
    queue    = params.aws_cpu_queue

    // These defaults are calibrated from the existing 6k trace. Index and
    // quantization requests below scale from actual manifest counts.
    cpus   = 2
    memory = '4 GB'
    time   = '4h'

    // Keep the nf-core resource classes, but use AWS-sized defaults. The
    // index and quantization tasks below replace these with input-scaled
    // requests when their manifests are available.
    withLabel:process_single {
        cpus   = 1
        memory = 2.GB
        time   = 4.h
    }
    withLabel:process_low {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }
    withLabel:process_medium {
        cpus   = 4
        memory = 8.GB
        time   = 8.h
    }
    withLabel:process_high {
        cpus   = 8
        memory = 16.GB
        time   = 16.h
    }
    withLabel:process_high_memory {
        cpus   = 4
        memory = 16.GB
        time   = 24.h
    }
    withLabel:process_gpu {
        resourceLabels = [pipeline: 'ginflow', executor: 'awsbatch', resource_class: 'gpu']
    }

    withName: '.*BUILD_RNA_GRAPHS|.*GENERATE_WINDOWS' {
        cpus   = 1
        memory = 2.GB
        time   = 4.h
    }
    withName: '.*GENERATE_QUANTIZED_WINDOWS' {
        cpus = 1
        time = 4.h
    }
    withName: '.*EMBED_RNA_GRAPHS' {
        // 6k/30k traces: about 1.5 CPU-equivalents and under 1 GB host RSS.
        cpus = 2
        time = 4.h
    }
    withName: '.*FIT_NODE_QUANTIZER' {
        cpus = 4
        time = 24.h
    }
    withName: '.*APPLY_NODE_QUANTIZER' {
        cpus = 4
        memory = { 4.GB * task.attempt }
        time = 24.h
    }
    withName: '.*BUILD_PQ_CAGRA_INDEX' {
        cpus = 4
        time = 24.h
    }
    withName: '.*BUILD_CUVS_INDEX' {
        cpus = 4
        time = 24.h
    }
    withName: '.*BUILD_FAISS_INDEX' {
        cpus = 4
        memory = {
            def count = n_windows as long
            def requested_gb = count > 0 ? Math.max(8, Math.ceil(4 + 6 * count / 1_000_000d) as int) : 8
            requested_gb * 1.GB * task.attempt
        }
        time = 24.h
    }
    withName: '.*BUILD_HNSWLIB_INDEX' {
        cpus = 4
        memory = {
            def count = n_windows as long
            def requested_gb = count > 0 ? Math.max(6, Math.ceil(4 + 2 * count / 1_000_000d) as int) : 32
            requested_gb * 1.GB * task.attempt
        }
        time = 24.h
    }
    withName: '.*SEARCH_FAISS|.*SEARCH_HNSWLIB' {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }
    withName: '.*SEARCH_CUVS' {
        cpus = 2
        time = 4.h
    }
    withName: '.*SEARCH_PQ_CAGRA' {
        cpus = 2
        time = 4.h
    }
    withName: '.*RERANK_CANDIDATES' {
        // 30k trace: about 1.45 CPU-equivalents.
        cpus = 2
        time = 8.h
    }
    withName: '.*CLUSTER_SEEDS' {
        cpus = 2
        time = 8.h
    }
    withName: '.*ALIGN_CLUSTERS' {
        // Cap the default thread request; memory is computed by the module.
        cpus   = { Math.max(1, Math.min(params.align_cpus.toString().toInteger(), 4)) }
        time   = 8.h
    }
    withName: '.*ESTIMATE_EVD' {
        // Cap the default thread request; memory is computed by the module.
        cpus   = { Math.max(1, Math.min(params.align_cpus.toString().toInteger(), 4)) }
        time   = 8.h
    }
    withName: '.*MERGE_ALIGNMENTS|.*SPLIT_ALIGNMENTS|.*WRITE_REPORT' {
        cpus   = 1
        memory = 2.GB
        time   = 8.h
    }
    withName: '.*DRAW_RNARTISTCORE|.*DRAW_R4RNA|.*DRAW_SW' {
        cpus   = 1
        memory = 2.GB
        time   = 4.h
    }

    // CPU FAISS uses the on-demand CPU queue; GPU FAISS uses the GPU Spot
    // queue until the GPU On-Demand quota is approved.
    withName: '.*BUILD_FAISS_INDEX|.*SEARCH_FAISS' {
        queue = {
            task.accelerator ? params.aws_gpu_queue : params.aws_cpu_ondemand_queue
        }
    }

    withName: '.*BUILD_CUVS_INDEX' {
        queue = {
            def required = task.ext.gpu_memory_gb as long
            if (required <= 15L) return params.aws_gpu_queue_16gb
            if (required <= 22L) return params.aws_gpu_queue_24gb
            if (required <= 44L) return params.aws_gpu_queue_48gb
            params.aws_gpu_queue_96gb
        }
    }
    withName: '.*BUILD_PQ_CAGRA_INDEX' {
        queue = {
            def required = task.ext.gpu_memory_gb as long
            if (required <= 15L) return params.aws_gpu_queue_16gb
            if (required <= 22L) return params.aws_gpu_queue_24gb
            if (required <= 44L) return params.aws_gpu_queue_48gb
            params.aws_gpu_queue_96gb
        }
    }

    // Embedding follows the task accelerator; CPU embedding remains on CPU.
    withName: '.*EMBED_RNA_GRAPHS' {
        queue = {
            if (!task.accelerator) {
                return params.aws_cpu_queue
            }
            def required = task.ext.gpu_memory_gb as long
            if (required <= 15L) return params.aws_gpu_queue_16gb
            if (required <= 22L) return params.aws_gpu_queue_24gb
            if (required <= 44L) return params.aws_gpu_queue_48gb
            params.aws_gpu_queue_96gb
        }
    }

    // Search and exact reranking can be CPU or GPU at runtime.
    withName: '.*SEARCH_CUVS' {
        queue = {
            if (!task.accelerator) {
                return params.aws_cpu_queue
            }
            def required = task.ext.gpu_memory_gb as long
            if (required <= 15L) return params.aws_gpu_queue_16gb
            if (required <= 22L) return params.aws_gpu_queue_24gb
            if (required <= 44L) return params.aws_gpu_queue_48gb
            params.aws_gpu_queue_96gb
        }
    }
    withName: '.*SEARCH_PQ_CAGRA' {
        queue = {
            if (!task.accelerator) {
                return params.aws_cpu_queue
            }
            def required = task.ext.gpu_memory_gb as long
            if (required <= 15L) return params.aws_gpu_queue_16gb
            if (required <= 22L) return params.aws_gpu_queue_24gb
            if (required <= 44L) return params.aws_gpu_queue_48gb
            params.aws_gpu_queue_96gb
        }
    }
    withName: '.*RERANK_CANDIDATES' {
        queue = {
            if (!task.accelerator) {
                return params.aws_cpu_queue
            }
            def required = task.ext.gpu_memory_gb as long
            if (required <= 15L) return params.aws_gpu_queue_16gb
            if (required <= 22L) return params.aws_gpu_queue_24gb
            if (required <= 44L) return params.aws_gpu_queue_48gb
            params.aws_gpu_queue_96gb
        }
    }
}
