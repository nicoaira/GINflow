nextflow_process {

    name "Test Process BUILD_RNA_GRAPHS"
    script "../main.nf"
    process "BUILD_RNA_GRAPHS"

    tag "modules"
    tag "build_rna_graphs"

    test("Should build a graph shard from a structures TSV with extra columns") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.graphs.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def sidecar = path(process.out.graphs.get(0).get(2))
                    def metadata = sidecar.json
                    assert metadata.record_count == 10
                    assert metadata.identifiers == [
                        'X58874.1/548-664',
                        'V00591.1/394-557',
                        'AF325695.1/199-9',
                        'M68929.1/186481-186410',
                        'EU020111.1/1-345',
                        'AL596170.1/192-86',
                        'M57569.1/218-27',
                        'URS0000D690D1_12908/1-144',
                        'AACY020396882.1/829-878',
                        'M34509.1/93-182'
                    ]
                    assert metadata.node_count == 349 + 349 + 349 + 350 + 347 + 342 + 368 + 144 + 350 + 332
                },
                {
                    assert snapshot(process.out.versions).match()
                }
            )
        }

    }

    test("Should expand mixed full molecules and slices into independent graphs") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'sliced' ],
                    file("${projectDir}/tests/data/sliced_structures.tsv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.graphs.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def metadata = path(process.out.graphs.get(0).get(2)).json
                    assert metadata.record_count == 5
                    assert metadata.identifiers == [
                        'DQ508819.1/1-88',
                        'M34509.1/93-182',
                        'X75790.1/378-471:150-244',
                        'X58874.1/548-664:34-90',
                        'X58874.1/548-664:40-95'
                    ]
                    // Sidecar keeps the source molecule; context nodes make the graph larger than the cores.
                    assert metadata.node_count > 88 + 332 + 94 + 56 + 55
                    def sequences = metadata.sequences
                    assert sequences[0].length() == 88
                    assert sequences[1].length() == 332
                    assert sequences[2].length() == 251
                    assert sequences[3].length() == 349
                    assert sequences[4] == sequences[3]
                }
            )
        }

    }

}
