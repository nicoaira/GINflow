nextflow_process {

    name "Test Process BUILD_CUVS_INDEX (GPU)"
    script "../main.nf"
    process "BUILD_CUVS_INDEX"

    tag "cuvs"
    tag "gpu"
    tag "modules"
    tag "build_cuvs_index"

    test("Should build a GPU CAGRA database with packed records") {

        config "./nextflow.gpu.config"

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
            run("EMBED_RNA_GRAPHS") {
                script "../../embed_rna_graphs/main.nf"
                process {
                    """
                    input[0] = BUILD_RNA_GRAPHS.out.graphs
                    """
                }
            }
            run("GENERATE_WINDOWS") {
                script "../../generate_windows/main.nf"
                process {
                    """
                    input[0] = EMBED_RNA_GRAPHS.out.embeddings
                    """
                }
            }
        }

        when {
            params {
                index                          = 'cagra'
                cagra_intermediate_graph_degree = 32
                cagra_graph_degree              = 16
            }
            process {
                """
                input[0] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> npz }.collect()
                input[1] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> manifest }.collect()
                input[2] = EMBED_RNA_GRAPHS.out.embeddings.map { meta, npz, manifest -> npz }.collect()
                input[3] = BUILD_RNA_GRAPHS.out.graphs.map { meta, tensors, sidecar -> sidecar }.collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.database.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def db = path(process.out.database.get(0))
                    assert db.resolve('cuvs/index.bin').exists()
                    assert !db.resolve('index.faiss').exists()
                    assert db.resolve('windows.tsv').exists()
                    assert db.resolve('embeddings.npz').exists()
                    assert db.resolve('records.tsv').exists()
                    def meta = db.resolve('meta.json').json
                    assert meta.backend == 'cuvs'
                    assert meta.index_type == 'CAGRA'
                    assert meta.index_class == 'CAGRA'
                    assert meta.metric == 'cuvs_cosine'
                    assert meta.gpu == true
                    assert meta.intermediate_graph_degree == 32
                    assert meta.graph_degree == 16
                    assert meta.n_records == 10
                    assert (meta.n_windows as int) > 0
                    assert meta.has_residue_embeddings == true
                },
                {
                    def versions = path(process.out.versions.get(0)).readLines().join('\n')
                    assert versions.contains('cuvs:')
                    assert versions.contains('cupy:')
                    assert versions.contains('numpy:')
                }
            )
        }

    }

}
