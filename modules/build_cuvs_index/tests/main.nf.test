nextflow_process {

    name "Test Process BUILD_CUVS_INDEX"
    script "../main.nf"
    process "BUILD_CUVS_INDEX"

    tag "cuvs"
    tag "modules"
    tag "build_cuvs_index"

    test("Should emit a GPU-only CAGRA database layout") {

        options "-stub"

        when {
            params {
                index = 'cagra'
            }
            process {
                """
                input[0] = file("${projectDir}/modules/generate_windows", checkIfExists: true)
                input[1] = file("${projectDir}/modules/generate_windows", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                input[3] = file("${projectDir}/modules/build_rna_graphs", checkIfExists: true)
                input[4] = file("${projectDir}/modules/quantize_nodes", checkIfExists: true)
                input[5] = 1000
                input[6] = 1200
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.database.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def database = path(process.out.database.get(0))
                    assert database.resolve('cuvs/index.bin').exists()
                    def metadata = database.resolve('meta.json').json
                    assert metadata.backend == 'cuvs'
                    assert metadata.index_type == 'CAGRA'
                }
            )
        }

    }

}
