nextflow_process {

    name "Test Process GENERATE_QUANTIZED_WINDOWS"
    script "../main.nf"
    process "GENERATE_QUANTIZED_WINDOWS"

    tag "modules"
    tag "quantization"

    test("Should emit quantized window shards") {

        options "-stub"

        when {
            params {
                quantize = 'pq'
                window_size = 11
                window_stride = 1
            }
            process {
                """
                input[0] = file("${projectDir}/modules/quantize_nodes", checkIfExists: true)
                input[1] = [
                    n_nodes: 1000L,
                    max_shard_nodes: 1000L,
                    max_record_nodes: 100L,
                    n_windows: 900L,
                    max_shard_windows: 900L,
                    max_record_windows: 90L
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.windows.size() == 1 },
                { assert process.out.versions.size() == 1 }
            )
        }

    }

}
