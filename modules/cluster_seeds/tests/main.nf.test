nextflow_process {

    name "Test Process CLUSTER_SEEDS"
    script "../main.nf"
    process "CLUSTER_SEEDS"

    tag "modules"
    tag "cluster_seeds"

    test("Should cluster self-search seeds from the smoke TSV") {

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
            run("EMBED_RNA_GRAPHS") {
                script "../../embed_rna_graphs/main.nf"
                process {
                    """
                    input[0] = BUILD_RNA_GRAPHS.out.graphs
                    """
                }
            }
            run("GENERATE_WINDOWS") {
                script "../../generate_windows/main.nf"
                process {
                    """
                    input[0] = EMBED_RNA_GRAPHS.out.embeddings
                    """
                }
            }
            run("BUILD_FAISS_INDEX") {
                script "../../build_faiss_index/main.nf"
                process {
                    """
                    input[0] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> npz }.collect()
                    input[1] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> manifest }.collect()
                    input[2] = EMBED_RNA_GRAPHS.out.embeddings.map { meta, npz, manifest -> npz }.collect()
                    input[3] = BUILD_RNA_GRAPHS.out.graphs.map { meta, tensors, sidecar -> sidecar }.collect()
                    input[4] = 1000L
                    """
                }
            }
            run("SEARCH_FAISS") {
                script "../../search_faiss/main.nf"
                process {
                    """
                    input[0] = GENERATE_WINDOWS.out.windows
                    input[1] = BUILD_FAISS_INDEX.out.database.collect()
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SEARCH_FAISS.out.seeds.map { meta, tsv -> tsv }.collectFile(name: 'seeds.tsv', keepHeader: true, skip: 1)
                input[1] = 1000L
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.clusters.size() == 1 },
                {
                    def clusters = path(process.out.clusters.get(0)).readLines()
                    assert clusters[0].startsWith('cluster_id')
                    def rows = clusters.drop(1).findAll { it }
                    assert rows.size() > 0
                    def selfRows = rows.findAll { line ->
                        def cols = line.split('\t')
                        cols[1] == cols[2]
                    }
                    assert selfRows.size() > 0
                    selfRows.each { line ->
                        def cols = line.split('\t')
                        assert (cols[3] as int) >= 2
                    }
                },
                {
                    assert snapshot(process.out.versions).match()
                }
            )
        }

    }

}
