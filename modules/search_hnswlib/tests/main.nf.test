nextflow_process {

    name "Test Process SEARCH_HNSWLIB"
    script "../main.nf"
    process "SEARCH_HNSWLIB"

    tag "modules"
    tag "hnswlib"

    test("Should emit a seed table for a PQ HNSWLIB query") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'query' ],
                    file("${projectDir}/modules/generate_windows/main.nf", checkIfExists: true),
                    file("${projectDir}/modules/generate_windows/environment.yml", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/modules/build_hnswlib_index", checkIfExists: true)
                input[2] = file("${projectDir}/vendor/hnswlib-0.8.0", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.seeds.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def seeds = path(process.out.seeds.get(0).get(1)).readLines()
                    assert seeds[0] == 'query_id\tquery_start\tquery_end\ttarget_id\ttarget_start\ttarget_end\tscore\trank'
                    assert seeds.size() == 1
                }
            )
        }

    }

}
