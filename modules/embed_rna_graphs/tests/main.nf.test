nextflow_process {

    name "Test Process EMBED_RNA_GRAPHS"
    script "../main.nf"
    process "EMBED_RNA_GRAPHS"

    tag "modules"
    tag "embed_rna_graphs"

    test("Should embed a graph shard built from the test structures TSV") {

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = BUILD_RNA_GRAPHS.out.graphs
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.embeddings.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def manifest = path(process.out.embeddings.get(0).get(2)).json
                    assert manifest.status == 'complete'
                    assert manifest.records.size() == 10
                },
                {
                    assert snapshot(process.out.versions).match()
                }
            )
        }

    }

    test("Should pass the full-precision flag to GINFINITY") {

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'full_precision' ],
                        file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            params {
                ginfinity_full_precision = true
            }
            process {
                """
                input[0] = BUILD_RNA_GRAPHS.out.graphs
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.embeddings.size() == 1 }
            )
        }

    }

    test("Should embed each slice as an independent core-length record") {

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'sliced' ],
                        file("${projectDir}/tests/data/sliced_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = BUILD_RNA_GRAPHS.out.graphs
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.embeddings.size() == 1 },
                {
                    def manifest = path(process.out.embeddings.get(0).get(2)).json
                    assert manifest.status == 'complete'
                    assert manifest.records.size() == 5
                    def byId = manifest.records.collectEntries { [it.identifier, it] }
                    assert byId['DQ508819.1/1-88'].core_length == 88
                    assert byId['DQ508819.1/1-88'].shape == [88, 128]
                    assert byId['M34509.1/93-182'].core_length == 332
                    assert byId['X75790.1/378-471:150-244'].core_length == 94
                    assert byId['X75790.1/378-471:150-244'].shape == [94, 128]
                    assert byId['X58874.1/548-664:34-90'].core_length == 56
                    assert byId['X58874.1/548-664:40-95'].core_length == 55
                    // Context nodes are in the graph, not in the returned embedding.
                    assert byId['X75790.1/378-471:150-244'].node_count > 94
                    assert byId['X58874.1/548-664:34-90'].node_count > 56
                }
            )
        }

    }

}
