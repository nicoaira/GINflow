nextflow_process {

    name "Test Process RERANK_CANDIDATES"
    script "../main.nf"
    process "RERANK_CANDIDATES"

    tag "modules"
    tag "rerank"

    test("Should emit a final seed table and rerank metrics") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'query' ],
                    file("${projectDir}/modules/search_hnswlib", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/modules/build_hnswlib_index", checkIfExists: true)
                input[2] = file("${projectDir}/modules/generate_windows", checkIfExists: true)
                input[3] = file("${projectDir}/modules/generate_windows", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.seeds.size() == 1 },
                { assert process.out.metrics.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def seeds = path(process.out.seeds.get(0).get(1)).readLines()
                    assert seeds[0] == 'query_id\tquery_start\tquery_end\ttarget_id\ttarget_start\ttarget_end\tscore\trank'
                },
                { assert path(process.out.metrics.get(0)).json.backend == 'exact_original_window_rerank' }
            )
        }
    }
}
