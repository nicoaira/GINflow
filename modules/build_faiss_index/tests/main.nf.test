nextflow_process {

    name "Test Process BUILD_FAISS_INDEX"
    script "../main.nf"
    process "BUILD_FAISS_INDEX"

    tag "modules"
    tag "build_faiss_index"

    test("Should index smoke-test windows") {

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
            run("EMBED_RNA_GRAPHS") {
                script "../../embed_rna_graphs/main.nf"
                process {
                    """
                    input[0] = BUILD_RNA_GRAPHS.out.graphs
                    """
                }
            }
            run("GENERATE_WINDOWS") {
                script "../../generate_windows/main.nf"
                process {
                    """
                    input[0] = EMBED_RNA_GRAPHS.out.embeddings
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> npz }.collect()
                input[1] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> manifest }.collect()
                input[2] = EMBED_RNA_GRAPHS.out.embeddings.map { meta, npz, manifest -> npz }.collect()
                input[3] = BUILD_RNA_GRAPHS.out.graphs.map { meta, tensors, sidecar -> sidecar }.collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.database.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def db = path(process.out.database.get(0))
                    assert db.resolve('index.faiss').exists()
                    assert db.resolve('windows.tsv').exists()
                    def meta = db.resolve('meta.json').json
                    assert meta.window_size == 11
                    assert meta.window_stride == 1
                    assert meta.window_dim == 1408
                    assert meta.metric == 'inner_product'
                    assert meta.index_type == 'FlatIP'
                    assert meta.l2_normalized == true
                    assert meta.n_records == 10
                    assert (meta.n_windows as int) > 0
                    assert meta.has_residue_embeddings == true
                    assert db.resolve('embeddings.npz').exists()
                    assert db.resolve('records.tsv').exists()
                },
                {
                    assert snapshot(process.out.versions).match()
                }
            )
        }

    }

    test("Should build an IVFFlat index") {

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
            run("EMBED_RNA_GRAPHS") {
                script "../../embed_rna_graphs/main.nf"
                process {
                    """
                    input[0] = BUILD_RNA_GRAPHS.out.graphs
                    """
                }
            }
            run("GENERATE_WINDOWS") {
                script "../../generate_windows/main.nf"
                process {
                    """
                    input[0] = EMBED_RNA_GRAPHS.out.embeddings
                    """
                }
            }
        }

        when {
            params {
                faiss_index = 'IVFFlat'
                faiss_nlist = 4
                faiss_nprobe = 4
            }
            process {
                """
                input[0] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> npz }.collect()
                input[1] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> manifest }.collect()
                input[2] = EMBED_RNA_GRAPHS.out.embeddings.map { meta, npz, manifest -> npz }.collect()
                input[3] = BUILD_RNA_GRAPHS.out.graphs.map { meta, tensors, sidecar -> sidecar }.collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def meta = path(process.out.database.get(0)).resolve('meta.json').json
                    assert meta.index_type == 'IVFFlat'
                    assert meta.index_class == 'IndexIVFFlat'
                    assert meta.nlist == 4
                    assert meta.nprobe == 4
                    assert meta.metric == 'inner_product'
                    assert (meta.n_windows as int) > 0
                }
            )
        }

    }

    test("Should build a ScaNN index") {

        tag "scann"

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
            run("EMBED_RNA_GRAPHS") {
                script "../../embed_rna_graphs/main.nf"
                process {
                    """
                    input[0] = BUILD_RNA_GRAPHS.out.graphs
                    """
                }
            }
            run("GENERATE_WINDOWS") {
                script "../../generate_windows/main.nf"
                process {
                    """
                    input[0] = EMBED_RNA_GRAPHS.out.embeddings
                    """
                }
            }
        }

        when {
            params {
                index = 'scann'
            }
            process {
                """
                input[0] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> npz }.collect()
                input[1] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> manifest }.collect()
                input[2] = EMBED_RNA_GRAPHS.out.embeddings.map { meta, npz, manifest -> npz }.collect()
                input[3] = BUILD_RNA_GRAPHS.out.graphs.map { meta, tensors, sidecar -> sidecar }.collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def db = path(process.out.database.get(0))
                    assert db.resolve('scann').exists()
                    assert !db.resolve('index.faiss').exists()
                    def meta = db.resolve('meta.json').json
                    assert meta.index_type == 'ScaNN'
                    assert meta.index_class == 'ScannSearcher'
                    assert meta.backend == 'scann'
                    assert meta.metric == 'inner_product'
                    assert meta.scann_scoring == 'brute_force'
                    assert (meta.n_windows as int) > 0
                    assert db.resolve('windows.tsv').exists()
                }
            )
        }

    }

    test("Should build an NGT QBG index") {

        tag "ngt"

        setup {
            run("BUILD_RNA_GRAPHS") {
                script "../../build_rna_graphs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'test' ],
                        file("${projectDir}/tests/data/smoke_test_structures.tsv", checkIfExists: true)
                    ]
                    """
                }
            }
            run("EMBED_RNA_GRAPHS") {
                script "../../embed_rna_graphs/main.nf"
                process {
                    """
                    input[0] = BUILD_RNA_GRAPHS.out.graphs
                    """
                }
            }
            run("GENERATE_WINDOWS") {
                script "../../generate_windows/main.nf"
                process {
                    """
                    input[0] = EMBED_RNA_GRAPHS.out.embeddings
                    """
                }
            }
        }

        when {
            params {
                index = 'ngt'
                ngt_index = 'QBG'
            }
            process {
                """
                input[0] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> npz }.collect()
                input[1] = GENERATE_WINDOWS.out.windows.map { meta, npz, manifest -> manifest }.collect()
                input[2] = EMBED_RNA_GRAPHS.out.embeddings.map { meta, npz, manifest -> npz }.collect()
                input[3] = BUILD_RNA_GRAPHS.out.graphs.map { meta, tensors, sidecar -> sidecar }.collect()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def db = path(process.out.database.get(0))
                    assert db.resolve('ngt').exists()
                    assert !db.resolve('index.faiss').exists()
                    def meta = db.resolve('meta.json').json
                    assert meta.index_type == 'QBG'
                    assert meta.backend == 'ngt'
                    assert meta.metric == 'l2'
                    assert (meta.n_windows as int) > 0
                    assert db.resolve('windows.tsv').exists()
                }
            )
        }

    }

}
