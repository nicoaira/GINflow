nextflow_process {

    name "Test Process SEARCH_PQ_CAGRA"
    script "../main.nf"
    process "SEARCH_PQ_CAGRA"

    tag "modules"
    tag "pq_cagra"

    test("Should emit a seed table for a PQ-CAGRA query") {

        options "-stub"

        when {
            params {
                index          = 'cagra'
                quantize       = 'pq'
                search_device  = 'cpu'
            }
            process {
                """
                input[0] = [
                    [ id: 'query' ],
                    file("${projectDir}/modules/generate_windows/main.nf", checkIfExists: true),
                    file("${projectDir}/modules/generate_windows/environment.yml", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/modules/build_pq_cagra_index", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.seeds.size() == 1 },
                { assert process.out.versions.size() == 1 },
                {
                    def seeds = path(process.out.seeds.get(0).get(1)).readLines()
                    assert seeds[0] == 'query_id\tquery_start\tquery_end\ttarget_id\ttarget_start\ttarget_end\tscore\trank'
                    assert seeds.size() == 1
                }
            )
        }

    }

}
