nextflow_process {

    name "Test Process DRAW_RNARTISTCORE"
    script "../main.nf"
    process "DRAW_RNARTISTCORE"

    tag "modules"
    tag "draw_rnartistcore"

    test("Should draw query and target SVGs from the plot fixture") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/plot_fixture.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.plots.size() == 1 },
                {
                    def plotDir = file(process.out.plots.get(0))
                    assert plotDir.isDirectory()
                    def svgs = plotDir.listFiles().findAll { it.name.endsWith('.svg') }
                    assert svgs.size() >= 2
                    svgs.each { svg ->
                        def text = svg.text.toLowerCase()
                        assert text.contains('<svg')
                        assert text.contains('#24b064')
                        assert text.contains('#adb5bd')
                    }
                },
                {
                    assert snapshot(process.out.versions).match()
                }
            )
        }

    }

}
