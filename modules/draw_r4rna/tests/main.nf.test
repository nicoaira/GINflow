nextflow_process {

    name "Test Process DRAW_R4RNA"
    script "../main.nf"
    process "DRAW_R4RNA"

    tag "modules"
    tag "draw_r4rna"

    test("Should draw a unified alignment arc plot from the plot fixture") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/plot_fixture.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.plots.size() == 1 },
                {
                    def plotDir = file(process.out.plots.get(0))
                    assert plotDir.isDirectory()
                    def svgs = plotDir.listFiles().findAll { it.name.endsWith('.svg') }
                    assert svgs.size() == 1
                    assert svgs[0].name.endsWith('_alignment.svg')
                    def text = svgs[0].text
                    assert text.contains('<svg')
                    assert text.contains('#24B064')
                    assert text.contains('#396E35')
                    assert text.contains('#ECDC86')
                    assert text.contains('same base')
                    assert text.contains('X06694')
                    assert text.contains('X13842')
                },
                {
                    assert snapshot(process.out.versions).match()
                }
            )
        }

    }

}
