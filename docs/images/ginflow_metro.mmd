%%metro grid: prepare_db | 0,0
%%metro grid: prepare_query | 0,1
%%metro grid: index | 1,0
%%metro grid: retrieve | 2,0
%%metro grid: align | 3,0
%%metro grid: report | 4,0

graph LR
    subgraph prepare_db [Prepare database]
        input_tsv[ ]
        db_graphs[Build graphs]
        db_embed[Embed graphs]
        db_windows[Slice windows]
        input_tsv -->|index,search| db_graphs
        db_graphs -->|index,search| db_embed
        db_embed -->|index,search| db_windows
    end

    subgraph prepare_query [Prepare query]
        query_tsv[ ]
        q_graphs[Build graphs]
        q_embed[Embed graphs]
        q_windows[Slice windows]
        query_tsv -->|search,existing| q_graphs
        q_graphs -->|search,existing| q_embed
        q_embed -->|search,existing| q_windows
    end

    subgraph index [Index]
        faiss_in[ ]
        build_index[Build index]
        estimate_evd[Estimate EVD]
        faiss_out[ ]
        faiss_in -->|existing| estimate_evd
        build_index -->|index,search| estimate_evd
        estimate_evd -->|index| faiss_out
    end

    subgraph retrieve [Search]
        search_index[Search index]
        cluster_seeds[Cluster seeds]
        split_clusters[Split clusters]
        search_index -->|search,existing| cluster_seeds
        cluster_seeds -->|search,existing| split_clusters
    end

    subgraph align [Align]
        align_clusters[GINFINITY-SW]
        merge_alignments[Merge alignments]
        alignments_out[ ]
        align_clusters -->|search,existing,rnartist,r4rna,sw| merge_alignments
        merge_alignments -->|search,existing| alignments_out
    end

    subgraph report [Report]
        draw_rnartist[RNArtistCore]
        draw_r4rna[R4RNA]
        draw_sw[SW matrices]
        write_report[Write report]
        report_out[ ]
        draw_rnartist -->|rnartist| write_report
        draw_r4rna -->|r4rna| write_report
        draw_sw -->|sw| write_report
        write_report -->|search,existing,rnartist,r4rna,sw| report_out
    end

    %% Inter-section edges
    db_windows -->|index,search| build_index
    q_windows -->|search,existing| search_index
    estimate_evd -->|search,existing| search_index
    split_clusters -->|search,existing| align_clusters
    merge_alignments -->|search,existing| write_report
    merge_alignments -->|rnartist| draw_rnartist
    merge_alignments -->|r4rna| draw_r4rna
    merge_alignments -->|sw| draw_sw
