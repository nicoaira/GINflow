graph LR
    subgraph prepare_db [Prepare embeddings]
        input_tsv[ ]
        db_graphs[Build graphs]
        db_embed[Embed graphs]
        db_windows[Generate windows]
        db_quantize[Quantize\nembeddings]
        db_qwindows[Generate\nquantized\nwindows]
        input_tsv -->|index,search| db_graphs
        db_graphs -->|index,search| db_embed
        db_embed -->|index,search| db_windows
        db_embed -->|index,search| db_quantize
        db_quantize -->|index,search| db_qwindows
    end

    subgraph prepare_query [Prepare query]
        query_tsv[ ]
        q_graphs[Build graphs]
        q_embed[Embed graphs]
        q_windows[Generate windows]
        q_quantize[Quantize\nembeddings]
        q_qwindows[Generate\nquantized\nwindows]
        query_tsv -->|search,existing| q_graphs
        q_graphs -->|search,existing| q_embed
        q_embed -->|search,existing| q_windows
        q_embed -->|search,existing| q_quantize
        q_quantize -->|search,existing| q_qwindows
    end

    subgraph index [Index]
        build_index[Build index]
        estimate_evd[Estimate EVD]
        index_out[ ]
        build_index -->|index,search| estimate_evd
        estimate_evd -->|index| index_out
    end

    subgraph retrieve [Search]
        %%metro exit: right | search,existing
        index_in[ ]
        search_index[Search index]
        rerank[Rerank]
        cluster_seeds[Cluster seeds]
        split_clusters[Split clusters]
        index_in -->|existing| search_index
        search_index -->|search,existing| rerank
        rerank -->|search,existing| cluster_seeds
        cluster_seeds -->|search,existing| split_clusters
    end

    subgraph align [Align]
        %%metro direction: TB
        %%metro entry: left | search,existing
        %%metro exit: bottom | search,existing
        align_clusters[SW Alignment]
        merge_alignments[Merge alignments]
        align_clusters -->|search,existing| merge_alignments
    end

    subgraph report [Report]
        %%metro direction: RL
        %%metro entry: top | search,existing
        plot_alignments[Plot alignments]
        write_report[Write report]
        report_out[ ]
        plot_alignments -->|search,existing| write_report
        write_report -->|search,existing| report_out
    end

    %% Inter-section edges
    db_windows -->|index,search| build_index
    db_qwindows -->|index,search| build_index
    q_windows -->|search,existing| search_index
    q_qwindows -->|search,existing| search_index
    estimate_evd -->|search| search_index
    split_clusters -->|search,existing| align_clusters
    merge_alignments -->|search,existing| plot_alignments
