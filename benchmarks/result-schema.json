{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nicoaira/ginflow/benchmarks/result-schema.json",
  "title": "GINflow vector-index benchmark result",
  "description": "One measured repeat, including reportable skipped and failed configurations.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "backend",
    "dataset_id",
    "dataset_window_count",
    "dimension",
    "metric",
    "k",
    "parameter_label",
    "parameters",
    "run_id",
    "repeat",
    "warmup_queries",
    "timed_queries",
    "qps",
    "latency_ms",
    "recall_at_100",
    "query_ids_sha256",
    "ground_truth_ids_sha256",
    "index_bytes",
    "build_seconds",
    "peak_rss_bytes",
    "peak_vram_bytes",
    "provenance",
    "error",
    "measurement"
  ],
  "properties": {
    "schema_version": { "const": "ginflow-benchmark-v1" },
    "status": { "enum": ["ok", "skipped", "error"] },
    "backend": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_window_count": { "type": "integer", "minimum": 1 },
    "dimension": { "type": "integer", "minimum": 1 },
    "metric": { "const": "cosine" },
    "k": { "const": 100 },
    "parameter_label": { "type": "string", "minLength": 1 },
    "parameters": { "type": "object" },
    "run_id": { "type": "string", "minLength": 1 },
    "repeat": { "type": "integer", "minimum": 0 },
    "warmup_queries": { "type": "integer", "minimum": 0 },
    "timed_queries": { "type": "integer", "minimum": 0 },
    "qps": { "type": ["number", "null"], "minimum": 0 },
    "latency_ms": {
      "type": ["object", "null"],
      "properties": {
        "mean": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 }
      }
    },
    "recall_at_100": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "query_ids_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ground_truth_ids_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "index_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "build_seconds": { "type": ["number", "null"], "minimum": 0 },
    "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "peak_vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "provenance": {
      "type": "object",
      "properties": {
        "git_commit": { "type": "string", "minLength": 1 },
        "runner_version": { "type": "string", "minLength": 1 },
        "hardware_id": { "type": "string", "minLength": 1 },
        "embedding_cache_id": { "type": "string", "minLength": 1 },
        "query_selection_id": { "type": "string", "minLength": 1 },
        "ground_truth_cache_id": { "type": "string", "minLength": 1 },
        "measurement_protocol": { "const": "fixed-query-batches-v1" },
        "query_batch_size": { "type": "integer", "minimum": 1 },
        "container": { "type": "string" },
        "image": { "type": "string" }
      }
    },
    "error": { "type": ["string", "null"] },
    "measurement": {
      "type": "object",
      "properties": {
        "protocol": { "const": "fixed-query-batches-v1" },
        "query_batch_size": { "type": "integer", "minimum": 1 },
        "timed_batch_count": { "type": "integer", "minimum": 1 },
        "timed_queries": { "type": "integer", "minimum": 1 },
        "latency_unit": { "const": "milliseconds_per_query_batch" },
        "qps_scope": { "const": "queries_per_second_over_timed_batches" },
        "timed_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "created_at": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": {
        "required": ["qps", "recall_at_100", "index_bytes", "build_seconds"],
        "properties": {
          "qps": { "type": "number", "exclusiveMinimum": 0 },
          "recall_at_100": { "type": "number", "minimum": 0, "maximum": 1 },
          "index_bytes": { "type": "integer", "minimum": 0 },
          "build_seconds": { "type": "number", "minimum": 0 },
          "latency_ms": {
            "type": "object",
            "required": ["mean", "p50", "p95"],
            "properties": {
              "mean": { "type": "number", "exclusiveMinimum": 0 },
              "p50": { "type": "number", "exclusiveMinimum": 0 },
              "p95": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "measurement": {
            "type": "object",
            "required": [
              "protocol",
              "query_batch_size",
              "timed_batch_count",
              "timed_queries",
              "latency_unit",
              "qps_scope"
            ],
            "properties": {
              "protocol": { "const": "fixed-query-batches-v1" },
              "query_batch_size": { "type": "integer", "minimum": 1 },
              "timed_batch_count": { "type": "integer", "minimum": 1 },
              "timed_queries": { "type": "integer", "minimum": 1 },
              "latency_unit": { "const": "milliseconds_per_query_batch" },
              "qps_scope": { "const": "queries_per_second_over_timed_batches" }
            }
          },
          "provenance": {
            "type": "object",
            "required": [
              "git_commit",
              "runner_version",
              "hardware_id",
              "embedding_cache_id",
              "query_selection_id",
              "ground_truth_cache_id",
              "measurement_protocol",
              "query_batch_size"
            ],
            "properties": {
              "measurement_protocol": { "const": "fixed-query-batches-v1" },
              "query_batch_size": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "properties": { "error": { "type": "string", "minLength": 1 } } }
    }
  ]
}
