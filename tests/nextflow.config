    faiss_hnsw_ef_construction  = 40
    faiss_hnsw_ef_search        = 16
    faiss_lsh_nbits             = null
    faiss_sq_type               = '8bit'
    scann_reorder               = 100
    scann_ah_dim                = 2
    scann_anisotropic           = 0.2
    scann_soar                  = false
    scann_leaves                = null
    scann_leaves_to_search      = null
