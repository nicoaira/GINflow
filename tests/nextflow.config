    cluster_span                 = 80
    cluster_min_seeds            = 2
    cluster_diagonal_tolerance   = 12
    cluster_max_diagonal_span    = 96
    cluster_max_seed_rank        = 10
    align_pad       = 32
    align_max_cells = 16777216
    evd_samples    = 200
    evd_max_length = 400
    evd_seed       = 1
    plot_backend          = 'none'
    plot_sw               = false
