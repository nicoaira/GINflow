    end_column        = 'end'
    no_slices         = false
    keep_paired_neighbours = true
    context_hops      = 4
    delimiter         = '\t'
    embed_device      = 'cpu'
    max_batch_nodes   = 60000
    max_batch_edges   = 300000
    query             = null
    database          = null
    window_size       = 11
    window_stride     = 1
    seed_k            = 50
    seed_min_similarity = 0.8
    index                       = 'faiss'
    faiss_index                 = 'flatip'
    faiss_gpu                   = false
    faiss_nlist                 = null
    faiss_nprobe                = null
