nextflow_pipeline {

    name "Test search modes"
    script "../main.nf"
    tag "pipeline"
    tag "search"

    test("build and query the same smoke TSV") {

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/smoke_test_structures.tsv"
                query      = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size = 2
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/faiss/index.faiss").exists()
            assert path("${params.outdir}/seeds.tsv").exists()
            def seeds = path("${params.outdir}/seeds.tsv").readLines()
            assert seeds[0] == 'query_id\tquery_start\tquery_end\ttarget_id\ttarget_start\ttarget_end\tscore\trank'
            def rows = seeds.drop(1).findAll { it }
            assert rows.size() > 0
            def selfHits = rows.findAll { line ->
                def cols = line.split('\t')
                cols[0] == cols[3] && cols[1] == cols[4] && cols[7] == '1'
            }
            assert selfHits.size() > 0
            assert path("${params.outdir}/clusters.tsv").exists()
            assert path("${params.outdir}/alignments.tsv").exists()
            assert path("${params.outdir}/report.html").exists()
            assert path("${params.outdir}/report.html").text.contains('Search report')
            def clusters = path("${params.outdir}/clusters.tsv").readLines()
            assert clusters.drop(1).findAll { it }.size() > 0
            def alignments = path("${params.outdir}/alignments.tsv").readLines()
            assert alignments[0].contains('evalue')
            def hitRows = alignments.drop(1).findAll { it }
            assert hitRows.size() > 0
            def evals = hitRows.collect { line -> line.split('\t')[5] as double }
            assert evals == evals.toSorted()
        }
    }

    test("build and query with IVFFlat") {

        when {
            params {
                outdir        = "$outputDir"
                input         = "${projectDir}/tests/data/smoke_test_structures.tsv"
                query         = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size    = 2
                faiss_index   = 'ivfflat'
                faiss_nlist   = 4
                faiss_nprobe  = 4
            }
        }

        then {
            assert workflow.success
            def meta = path("${params.outdir}/faiss/meta.json").json
            assert meta.index_type == 'IVFFlat'
            assert meta.index_class == 'IndexIVFFlat'
            assert meta.nlist == 4
            assert meta.nprobe == 4
            assert path("${params.outdir}/seeds.tsv").exists()
            def rows = path("${params.outdir}/seeds.tsv").readLines().drop(1).findAll { it }
            assert rows.size() > 0
            assert path("${params.outdir}/alignments.tsv").exists()
            assert path("${params.outdir}/report.html").exists()
        }
    }

    test("each slice is an independent query") {

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/sliced_structures.tsv"
                query      = "${projectDir}/tests/data/sliced_structures.tsv"
                shard_size = 10
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/seeds.tsv").exists()
            def seeds = path("${params.outdir}/seeds.tsv").readLines().drop(1).findAll { it }
            def queryIds = seeds.collect { it.split('\t')[0] } as Set
            assert queryIds.contains('X75790.1/378-471:150-244')
            assert queryIds.contains('X58874.1/548-664:34-90')
            assert queryIds.contains('X58874.1/548-664:40-95')
            def selfHits = seeds.findAll { line ->
                def cols = line.split('\t')
                cols[0] == cols[3] && cols[1] == cols[4] && cols[7] == '1'
            }
            assert selfHits.size() > 0
            assert path("${params.outdir}/alignments.tsv").exists()
            def hitRows = path("${params.outdir}/alignments.tsv").readLines().drop(1).findAll { it }
            assert hitRows.size() > 0
            def alignedIds = hitRows.collect { it.split('\t')[1] } as Set
            assert alignedIds.intersect([
                'X75790.1/378-471:150-244',
                'X58874.1/548-664:34-90',
                'X58874.1/548-664:40-95'
            ] as Set).size() > 0
        }
    }

    test("build and query with ScaNN") {

        tag "scann"

        when {
            params {
                outdir      = "$outputDir"
                input       = "${projectDir}/tests/data/smoke_test_structures.tsv"
                query       = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size  = 2
                index = 'scann'
            }
        }

        then {
            assert workflow.success
            def meta = path("${params.outdir}/faiss/meta.json").json
            assert meta.index_type == 'ScaNN'
            assert meta.backend == 'scann'
            assert path("${params.outdir}/faiss/scann").exists()
            assert !path("${params.outdir}/faiss/index.faiss").exists()
            assert path("${params.outdir}/seeds.tsv").exists()
            def rows = path("${params.outdir}/seeds.tsv").readLines().drop(1).findAll { it }
            assert rows.size() > 0
            def selfHits = rows.findAll { line ->
                def cols = line.split('\t')
                cols[0] == cols[3] && cols[1] == cols[4] && cols[7] == '1'
            }
            assert selfHits.size() > 0
            assert path("${params.outdir}/alignments.tsv").exists()
            assert path("${params.outdir}/report.html").exists()
        }
    }

    test("dispatch NGT build and search") {

        tag "ngt"
        options "-stub"

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/smoke_test_structures.tsv"
                query      = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size = 2
                index      = 'ngt'
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/faiss/ngt/.stub").exists()
            assert path("${params.outdir}/seeds.tsv").exists()
        }
    }

    test("dispatch HNSWLIB quantized build and search") {

        tag "hnswlib"
        options "-stub"

        when {
            params {
                outdir      = "$outputDir"
                input       = "${projectDir}/tests/data/smoke_test_structures.tsv"
                query       = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size  = 2
                index       = 'hnswlib'
                node_quantization_k = 8
                hnswlib_m = 8
                hnswlib_ef_construction = 40
                hnswlib_ef_search = 20
            }
        }

        then {
            assert workflow.success
            def meta = path("${params.outdir}/faiss/meta.json").json
            assert meta.backend == 'hnswlib'
            assert meta.index_type == 'HNSWLIB_COMPACT'
            assert meta.candidate_representation == 'uint16_centroid_codes'
            assert path("${params.outdir}/faiss/index.bin").exists()
            assert path("${params.outdir}/faiss/quantization/centroids.npy").exists()
            assert path("${params.outdir}/windows_quantized").exists()
            assert path("${params.outdir}/seeds.tsv").exists()
            assert path("${params.outdir}/report.html").exists()
        }
    }

    test("query an existing database (stub)") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir     = "$outputDir"
                input      = null
                query      = "${projectDir}/tests/data/smoke_test_structures.tsv"
                database   = "${projectDir}/modules/generate_windows"
                shard_size = 2
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/seeds.tsv").exists()
            assert !path("${params.outdir}/faiss/index.faiss").exists()
        }
    }
}
