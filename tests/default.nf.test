nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile smoke_test") {

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size = 2
            }
        }

        then {
            assert workflow.success
            assert !path("${params.outdir}/samples.csv").exists()
            assert !path("${params.outdir}/quantization").exists()
            assert !path("${params.outdir}/graphs_shards").exists()
            assert !path("${params.outdir}/embeddings_shards").exists()
            assert !path("${params.outdir}/windows_shards").exists()
            assert !path("${params.outdir}/windows_quantized").exists()
            assert path("${params.outdir}/index/index.faiss").exists()
            assert path("${params.outdir}/index/windows.tsv").exists()
            assert path("${params.outdir}/index/embeddings.npz").exists()
            assert path("${params.outdir}/index/records.tsv").exists()
            assert path("${params.outdir}/index/evd.json").exists()
            def evd = path("${params.outdir}/index/evd.json").json
            assert (evd.lambda as double) > 0
            assert (evd.K as double) > 0
            def meta = path("${params.outdir}/index/meta.json").json
            assert meta.window_size == 11
            assert meta.n_windows > 0
            assert meta.index_type == 'FlatIP'
            assert !path("${params.outdir}/seeds/seeds.tsv").exists()
        }
    }

    test("sliced graphs become independent FAISS subjects") {

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/sliced_structures.tsv"
                shard_size = 10
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/index/index.faiss").exists()
            def records = path("${params.outdir}/index/records.tsv").readLines()
            assert records[0] == 'transcript_id\tsequence\tsecondary_structure'
            def rows = records.drop(1).findAll { it }
            assert rows.size() == 5
            def byId = rows.collectEntries { line ->
                def cols = line.split('\t', 3)
                [cols[0], cols]
            }
            assert byId.keySet() == [
                'DQ508819.1/1-88',
                'M34509.1/93-182',
                'X75790.1/378-471:150-244',
                'X58874.1/548-664:34-90',
                'X58874.1/548-664:40-95'
            ] as Set
            assert byId['DQ508819.1/1-88'][1].length() == 88
            assert byId['X75790.1/378-471:150-244'][1].length() == 94
            assert byId['X58874.1/548-664:34-90'][1].length() == 56
            assert byId['X58874.1/548-664:40-95'][1].length() == 55
            assert byId['X58874.1/548-664:34-90'][1] != byId['X58874.1/548-664:40-95'][1]
            assert byId['X58874.1/548-664:34-90'][2].length() == 56
            assert byId['X58874.1/548-664:40-95'][2].length() == 55
            byId.each { id, cols ->
                assert cols[1].length() == cols[2].length()
                def depth = 0
                cols[2].each { ch ->
                    if (ch == '(') depth += 1
                    else if (ch == ')') depth -= 1
                    assert depth >= 0
                }
                assert depth == 0
            }
            def meta = path("${params.outdir}/index/meta.json").json
            assert meta.n_records == 5
            assert meta.n_windows > 0
            def windows = path("${params.outdir}/index/windows.tsv").readLines().drop(1).findAll { it }
            assert windows.every { line ->
                def cols = line.split('\t')
                byId.containsKey(cols[1])
            }
        }
    }

    test("publishes optional graph, embedding, and window shards") {

        options "-stub"

        when {
            params {
                outdir                = "$outputDir"
                input                 = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size            = 2
                save_graphs           = true
                save_embeddings       = true
                save_windows          = true
            }
        }

        then {
            assert workflow.success
            assert getAllFilesFromDir("${params.outdir}/graphs_shards", includeDir: false)
                .findAll { it.name.endsWith('.safetensors') }.size() >= 1
            assert getAllFilesFromDir("${params.outdir}/embeddings_shards", includeDir: false)
                .findAll { it.name.endsWith('.npz') }.size() >= 1
            assert getAllFilesFromDir("${params.outdir}/windows_shards", includeDir: false)
                .findAll { it.name.endsWith('.windows.npz') }.size() >= 1
            assert !path("${params.outdir}/samples.csv").exists()
        }
    }

    test("publishes the SQ quantizer inside the index") {

        options "-stub"

        when {
            params {
                outdir     = "$outputDir"
                input      = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size = 2
                quantize   = 'sq'
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/index/index.faiss").exists()
            assert path("${params.outdir}/index/quantization/quantizer.json").exists()
            assert !path("${params.outdir}/quantization").exists()
            assert !path("${params.outdir}/windows_shards").exists()
            assert !path("${params.outdir}/windows_quantized").exists()
        }
    }

    test("publishes optional quantized window shards") {

        options "-stub"

        when {
            params {
                outdir                  = "$outputDir"
                input                   = "${projectDir}/tests/data/smoke_test_structures.tsv"
                shard_size              = 2
                quantize                = 'sq'
                save_quantized_windows = true
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/windows_quantized").exists()
            assert getAllFilesFromDir("${params.outdir}/windows_quantized", includeDir: false)
                .findAll { it.name.endsWith('.windows.npz') }.size() >= 1
        }
    }
}
