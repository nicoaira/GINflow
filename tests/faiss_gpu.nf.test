nextflow_pipeline {

    name "Test FAISS GPU validation"
    script "../main.nf"
    tag "pipeline"
    tag "faiss"

    test("GPU FAISS can be selected without a GPU profile") {

        options "-stub"

        when {
            params {
                outdir        = "$outputDir"
                input         = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_device  = 'gpu'
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/index/index.faiss").exists()
        }
    }

    test("legacy faiss_gpu remains a compatibility alias") {

        options "-stub"

        when {
            params {
                outdir    = "$outputDir"
                input     = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_gpu = 'yes'
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/index/index.faiss").exists()
        }
    }

    test("GPU FAISS is rejected for IVFFlat") {

        when {
            params {
                outdir       = "$outputDir"
                input        = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_device = 'gpu'
                faiss_index  = 'ivfflat'
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("GPU FAISS is rejected for HNSW") {

        when {
            params {
                outdir       = "$outputDir"
                input        = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_device = 'gpu'
                faiss_index  = 'hnsw'
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("unknown --index scann is an error") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/smoke_test_structures.tsv"
                index  = 'scann'
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("faiss_index scann is an error") {

        when {
            params {
                outdir       = "$outputDir"
                input        = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_index  = 'scann'
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("GPU-only cuVS builds can run without a GPU profile") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/smoke_test_structures.tsv"
                index  = 'cagra'
            }
        }

        then {
            assert workflow.success
            assert path("${params.outdir}/index/meta.json").exists()
        }
    }

}
