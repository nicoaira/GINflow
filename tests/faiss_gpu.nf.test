nextflow_pipeline {

    name "Test FAISS GPU validation"
    script "../main.nf"
    tag "pipeline"
    tag "faiss"

    test("faiss_gpu without -profile gpu is an error") {

        when {
            params {
                outdir    = "$outputDir"
                input     = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_gpu = true
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("faiss_gpu is rejected for IVFFlat") {

        when {
            params {
                outdir       = "$outputDir"
                input        = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_gpu    = true
                faiss_index  = 'ivfflat'
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("faiss_gpu is rejected for HNSW") {

        when {
            params {
                outdir       = "$outputDir"
                input        = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_gpu    = true
                faiss_index  = 'hnsw'
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("unknown --index scann is an error") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/smoke_test_structures.tsv"
                index  = 'scann'
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("faiss_index scann is an error") {

        when {
            params {
                outdir       = "$outputDir"
                input        = "${projectDir}/tests/data/smoke_test_structures.tsv"
                faiss_index  = 'scann'
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("cuVS without -profile gpu is an error") {

        when {
            params {
                outdir = "$outputDir"
                input  = "${projectDir}/tests/data/smoke_test_structures.tsv"
                index  = 'cagra'
            }
        }

        then {
            assert workflow.failed
        }
    }

}
